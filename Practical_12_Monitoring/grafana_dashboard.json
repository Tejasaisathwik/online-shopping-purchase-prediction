{
  "dashboard": {
    "id": null,
    "uid": "online-shopping-monitoring",
    "title": "Online Shopping Prediction - API Monitoring",
    "tags": ["mlops", "practical-12", "online-shopping"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 4, "w": 8, "x": 0, "y": 0},
        "type": "stat",
        "title": "Model Loaded",
        "datasource": {"type": "prometheus", "uid": "fg2lecr7c75kwa"},
        "targets": [
          {
            "datasource": {"type": "prometheus", "uid": "fg2lecr7c75kwa"},
            "expr": "online_shopping_api_model_loaded",
            "legendFormat": "Model Ready"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"options": {"0": {"text": "NOT LOADED", "color": "red"}, "1": {"text": "LOADED", "color": "green"}}, "type": "value"}
            ],
            "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
          }
        }
      },
      {
        "id": 2,
        "gridPos": {"h": 4, "w": 8, "x": 8, "y": 0},
        "type": "stat",
        "title": "Total API Requests",
        "datasource": {"type": "prometheus", "uid": "fg2lecr7c75kwa"},
        "targets": [
          {
            "datasource": {"type": "prometheus", "uid": "fg2lecr7c75kwa"},
            "expr": "sum(online_shopping_api_http_requests_total)",
            "legendFormat": "Requests"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short"
          }
        }
      },
      {
        "id": 3,
        "gridPos": {"h": 4, "w": 8, "x": 16, "y": 0},
        "type": "stat",
        "title": "Successful Predictions",
        "datasource": {"type": "prometheus", "uid": "fg2lecr7c75kwa"},
        "targets": [
          {
            "datasource": {"type": "prometheus", "uid": "fg2lecr7c75kwa"},
            "expr": "sum(online_shopping_api_predictions_total{result=\"success\"})",
            "legendFormat": "Predictions"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short"
          }
        }
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "type": "timeseries",
        "title": "Requests per Second",
        "datasource": {"type": "prometheus", "uid": "fg2lecr7c75kwa"},
        "targets": [
          {
            "datasource": {"type": "prometheus", "uid": "fg2lecr7c75kwa"},
            "expr": "sum(rate(online_shopping_api_http_requests_total[1m]))",
            "legendFormat": "req/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20},
            "unit": "reqps"
          }
        }
      },
      {
        "id": 5,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "type": "timeseries",
        "title": "Client/Server Error Rate (4xx / 5xx)",
        "datasource": {"type": "prometheus", "uid": "fg2lecr7c75kwa"},
        "targets": [
          {
            "datasource": {"type": "prometheus", "uid": "fg2lecr7c75kwa"},
            "expr": "sum(rate(online_shopping_api_http_requests_total{status=~\"4..|5..\"}[1m]))",
            "legendFormat": "errors/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"fixedColor": "red", "mode": "fixed"},
            "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 25},
            "unit": "errorsps"
          }
        }
      },
      {
        "id": 6,
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
        "type": "timeseries",
        "title": "P95 Request Latency",
        "datasource": {"type": "prometheus", "uid": "fg2lecr7c75kwa"},
        "targets": [
          {
            "datasource": {"type": "prometheus", "uid": "fg2lecr7c75kwa"},
            "expr": "histogram_quantile(0.95, sum by (le) (rate(online_shopping_api_http_request_duration_seconds_bucket[5m])))",
            "legendFormat": "P95 Latency"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15},
            "unit": "s"
          }
        }
      }
    ]
  },
  "overwrite": true
}
